# 로컬 개발용 환경변수 (backend/local-infra 와 붙여 쓰는 값).
#
#   cp .env.local.example .env.local
#
# uvicorn 직접 실행:   set -a && . ./.env.local && set +a && uvicorn app.main:app --reload
# docker compose:      docker compose -f docker-compose.local.yml up -d --build
#
# ⚠️ 값 뒤에 주석(#)을 붙이지 말 것 — env_file 은 주석까지 값으로 읽는다.
# 자세한 설명은 LOCAL_DEV.md 참고.


# ── 자격증명 ──────────────────────────────────────────────────────────────
# MOCK_AI=true 면 Gemini 를 호출하지 않고 가짜 응답을 쓴다. 키 없이 띄울 수 있고
# 배선(S3 읽기 → 3단계 → 콜백)과 동시성을 확인할 수 있다. 분석 품질은 확인 불가.
# 실제 분석을 보려면 false 로 바꾸고 GEMINI_API_KEY 를 채운다.
MOCK_AI=true
GEMINI_API_KEY=
# 호출 엔드포인트(SSAFY GMS 프록시). MOCK_AI=true 면 쓰이지 않는다.
GEMINI_BASE_URL=
# 카테고리 아이콘 생성(OpenAI 공식 API 직결 — GMS 는 이미지 생성을 중계하지 않는다).
# MOCK_AI=true 면 단색 PNG 로 대체되므로 비워 둬도 배선 확인은 끝까지 된다.
OPENAI_API_KEY=

# analysis-worker 의 internal.callback.token 과 **같은 값**이어야 한다.
# (backend/analysis-worker application-local.yml / application-docker.yml 기본값)
INTERNAL_TOKEN=local-dev-internal-token


# ── Spring(analysis-worker) 연동 ──────────────────────────────────────────
# SPRING_ENABLED=false 여도 요청에 callbackUrl 이 있으면 그쪽으로는 콜백을 보낸다
# (spring_client.post_callback 참고). analysis-worker 는 항상 callbackUrl 을 실어
# 보내므로 false 로 두어도 콜백은 도착한다.
# true 로 두면 10-5 지식 후보 조회(GET /internal/v1/user/{id}/knowledge-candidates)도
# 시도하는데, worker 에는 그 엔드포인트가 없어 건당 타임아웃(SPRING_TIMEOUT)만 버린다.
SPRING_ENABLED=false
SPRING_BASE_URL=http://localhost:8081
SPRING_TIMEOUT=3

APP_API_AUTH=false
ENABLE_DOCS=true


# ── MinIO (backend/local-infra) ───────────────────────────────────────────
# 호스트에서 uvicorn 으로 띄울 때:      http://localhost:9002
# docker-compose.local.yml 로 띄울 때:  http://minio:9000  (compose 파일이 덮어씀)
# 계정은 local-infra/docker-compose.yml 의 MINIO_ROOT_USER/PASSWORD.
S3_ENDPOINT=http://localhost:9002
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pictures
S3_THUMBNAIL_BUCKET=thumbnails
# 카테고리 아이콘 버킷. scripts/seed_minio.py 가 만들어 준다.
S3_CATEGORY_ICON_BUCKET=category-thumbnails
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_CONNECT_TIMEOUT=3
S3_READ_TIMEOUT=10
S3_MAX_ATTEMPTS=2
PRESIGNED_READ_URLS=false


# ── OpenSearch ────────────────────────────────────────────────────────────
# FULL 파이프라인은 OpenSearch 없이도 돈다(색인 실패는 경고만 남기고 통과).
# 검색·목록 API(/api/v1/*)까지 보려면 docker-compose.local.yml 의 search 프로필로 띄운다:
#   docker compose -f docker-compose.local.yml --profile search up -d
# 그때는 OPENSEARCH_HOST=opensearch, USE_SSL=false 로 둔다(로컬은 보안 플러그인 끔).
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=screenshot_kb


# ── 모델 ──────────────────────────────────────────────────────────────────
# 역할별 변수 의미는 .env.example 참고. INFORMATIVE/DOCUMENT/QUERY_PARSE 는
# 미설정 시 LLM 을 따른다.
LLM_MODEL_NAME=gemini-2.5-flash
INFORMATIVE_MODEL_NAME=gemini-2.5-flash
DOCUMENT_MODEL_NAME=gemini-3.5-flash
QUERY_PARSE_MODEL_NAME=gemini-2.5-flash-lite
VISION_MODEL_NAME=gemini-2.5-flash-lite
EMBEDDING_MODEL_NAME=gemini-embedding-2

# thinking 제어: BUDGET 은 2.5 계열(0=끔), LEVEL 은 3.x 계열(빈 값=미전송)
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=
# 프롬프트 정적 프리픽스 재배치(implicit caching). 기본 false —
# 로그 cached= 확인 + 라벨셋 A/B 후에만 켠다. 상세는 .env.example 주석.
PROMPT_STATIC_PREFIX=false
# analysis-worker 의 EMBEDDING_DIM(768)·pgvector vector(768) 과 반드시 일치.
# 어긋나면 콜백은 도착해도 worker 가 "임베딩 차원 불일치" 로 벡터를 버린다.
EMBEDDING_DIM=768


# ── 분류·동시성 ───────────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.80
DEFAULT_MAX_TAGS=10
HTTP_TIMEOUT=30
FIXED_USER_ID=1

# 동시 FULL 요청 상한. 데드락 재현 테스트가 이 값(4)을 기준으로 한다.
MAX_CONCURRENT_STAGES=4
GEMINI_MAX_ATTEMPTS=5
GEMINI_BACKOFF_BASE=1.0
GEMINI_BACKOFF_MAX=60
GEMINI_TIMEOUT=90


# ── 썸네일 ────────────────────────────────────────────────────────────────
THUMBNAIL_SQUARE=true
THUMBNAIL_MAX_SIZE=0
THUMBNAIL_QUALITY=82
