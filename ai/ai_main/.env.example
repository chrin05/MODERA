# AI 서비스 환경변수 예시.
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 .gitignore 로 제외되어 있다.
#
# ⚠️ 값 뒤에 주석(#)을 붙이지 말 것.
#    docker compose 의 env_file 은 주석까지 값으로 읽어 숫자 변환에 실패한다.
#    (잘못된 예: MAX_CONCURRENT_STAGES=4   # 동시 처리 수)


# ── LLM 프로바이더 ────────────────────────────────────────────────────────
# LLM 호출(정보성 판정·이미지 분석·AGENT·문서 생성·질의 변환)을 어디로 보낼지.
#   gemini  기존 동작. GMS 프록시 경유 Gemini
#   claude  auth2api(로컬 OAuth 프록시) 경유 Anthropic. 아래 "Claude" 섹션 참고
# 잘못된 값을 넣으면 기동 시 즉시 실패한다(런타임에 조용히 gemini 로 새지 않게).
#
# ⚠️ 임베딩은 이 값과 **무관하게 항상 Gemini** 다. Anthropic 에는 임베딩
#    엔드포인트가 없다(POST /v1/embeddings → 404). 그래서 claude 모드에서도
#    GEMINI_API_KEY / GEMINI_BASE_URL / EMBEDDING_* 는 그대로 필요하다.
LLM_PROVIDER=gemini


# ── 자격증명 (필수, 기본값 없음 — 미설정 시 기동 실패) ────────────────────
# LLM_PROVIDER 와 무관하게 항상 필요하다(카테고리 벡터 임베딩이 쓴다).
GEMINI_API_KEY=
# Spring ↔ AI, 앱 ↔ AI 공용 내부 토큰. 백엔드와 같은 값을 써야 한다.
INTERNAL_TOKEN=

# Gemini 호출 엔드포인트. SSAFY GMS 프록시 경유. SDK 가 뒤에 /v1beta/... 를
# 붙이므로 업스트림 호스트까지 포함한 접두사를 넣는다. 구글 직결로 돌리려면
# https://generativelanguage.googleapis.com 로 바꾼다.
GEMINI_BASE_URL=


# ── Spring 내부 API (10-4 콜백, 10-5 후보 조회) ───────────────────────────
# SPRING_ENABLED: MVP 는 앱↔AI 직결이라 Spring 이 떠 있지 않다. 그 상태로
#   10-5 를 호출하면 연결 실패까지 건당 약 4초를 그냥 버리므로 false 로 둔다.
#   Spring 연동이 복구되면 true 로 되돌린다.
# SPRING_TIMEOUT: Spring 내부 호출 타임아웃(초). 같은 네트워크 안이라 짧게 잡는다.
SPRING_BASE_URL=http://spring-api:8080
SPRING_ENABLED=false
SPRING_TIMEOUT=3


# ── 앱 API 인증 ───────────────────────────────────────────────────────────
# APP_API_AUTH: Spring 완성 전까지의 임시 스위치.
#   false 면 /api/v1/* 을 토큰 없이 열어 준다(Android 가 Spring 을 거치지 않고
#   직접 부르는 기간용). /internal/v1/* 은 이 값과 무관하게 항상 토큰을 요구한다.
#   ⚠️ 서버를 외부에 노출한다면 nginx 등 앞단에서 접근을 제한해야 한다.
APP_API_AUTH=false


# ── API 문서 UI (/docs, /redoc) ───────────────────────────────────────────
# 개발·팀 공유용. 외부에 노출되는 서버에서는 false 로 끄는 것을 권장한다
# (엔드포인트 구조와 스키마가 그대로 드러난다).
ENABLE_DOCS=true


# ── 오브젝트 스토리지 (MinIO, S3 호환) ────────────────────────────────────
# 원본 이미지를 s3Key 로 읽어 분석·썸네일 생성에 사용한다.
#
# S3_ENDPOINT 는 접속 위치에 따라 달라진다.
#   - 서버 배포(MinIO 와 같은 도커 네트워크): http://minio:9000
#   - 로컬 개발(SSH 터널로 9000 포워딩):      http://host.docker.internal:9000
#     예) ssh -N -L 9000:localhost:9000 <계정>@<서버>
#
# MinIO 는 path-style 접근이 필요하다(버킷을 호스트명이 아닌 경로로 붙임).
# 읽기 전용 계정을 쓰는 것을 권장한다.
# S3_PUBLIC_ENDPOINT: 앱에 건네줄 presigned 업로드 URL 을 만들 때 쓰는 **공개 주소**.
#   presigned URL 은 endpoint 를 host 로 그대로 박아서 만들어지는데, 내부 주소
#   (http://minio:9000)는 휴대폰에서 접근할 수 없다. 서버 내부 읽기·쓰기는 S3_ENDPOINT 로,
#   앱에 주는 URL 만 이 값으로 만든다. 비우면 S3_ENDPOINT 를 그대로 쓴다.
#   예) S3_PUBLIC_ENDPOINT=https://i15d207.p.ssafy.io
#
#   ⚠️ 경로 prefix 를 붙이지 말 것(https://.../s3 같은 형태). SigV4 는 경로까지
#      서명하는데, 리버스 프록시가 그 prefix 를 벗겨 MinIO 로 넘기면 서명한 경로와
#      검증하는 경로가 달라져 SignatureDoesNotMatch 403 이 난다.
#      nginx 는 /pictures/, /thumbnails/ 를 경로 변형 없이 MinIO 로 넘긴다
#      (infra/nginx/conf.d/default.conf 참고).
# UPLOAD_URL_EXPIRES_IN: presigned 업로드 URL 유효시간(초). 명세 4-1 예시는 600.
# MAX_UPLOAD_MB: 명세 4-1 fileSize 상한(5MB).
# PRESIGNED_READ_URLS: 조회용 이미지 주소(thumbnailUrl·imageUrl)를 presigned 로 줄지.
#   업로드는 presigned 가 필수지만(앱이 스토리지에 직접 올려야 함), 조회까지 그렇게 하면
#   만료 때문에 손해다 — 서명이 매번 바뀌어 앱 이미지 캐시가 계속 깨지고, 목록 응답을
#   캐시해 뒀다 나중에 열면 이미지가 안 나온다.
#   그래서 기본은 만료 없는 서버 경유 경로다. 서버 이미지 트래픽이 부담되면 true 로.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=
PRESIGNED_READ_URLS=false
# S3_CONNECT_TIMEOUT / S3_READ_TIMEOUT / S3_MAX_ATTEMPTS:
#   스토리지가 죽었을 때 요청이 무한정 매달리지 않게 하는 값. 기본값(60초×5회)이면
#   MinIO 가 잠깐 내려가도 목록·썸네일이 몇 분씩 멈춘다.
S3_CONNECT_TIMEOUT=3
S3_READ_TIMEOUT=10
S3_MAX_ATTEMPTS=2
UPLOAD_URL_EXPIRES_IN=600
MAX_UPLOAD_MB=5
S3_BUCKET=pictures


# 썸네일 관련 설정은 아래 "썸네일" 섹션에 모아 두었다.


# ── OpenSearch (검색 색인·조회) ───────────────────────────────────────────
# docker compose 로 띄우면 호스트는 컨테이너 이름(opensearch)이다.
# 보안 플러그인을 켜므로 HTTPS + 인증을 쓴다. 인증서는 자체 서명이라 검증은 끈다.
# 비밀번호는 대문자·소문자·숫자·특수문자 포함 8자 이상이어야 한다(2.12+ 요구사항).
# OPENSEARCH_INITIAL_ADMIN_PASSWORD 와 OPENSEARCH_PASSWORD 는 같은 값을 넣는다.
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=true
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
OPENSEARCH_INDEX=screenshot_kb


# ── 모델 ──────────────────────────────────────────────────────────────────
# GMS 허용: gemini-2.5-flash-lite / gemini-2.5-flash / gemini-2.5-pro / gemini-3.5-flash
# LLM_MODEL_NAME: AGENT 메타데이터 생성(대량 분석 주력)
# INFORMATIVE_MODEL_NAME: 정보성 판정. 미설정 시 LLM 을 따름
# DOCUMENT_MODEL_NAME: 문서 생성(명세 11장). 미설정 시 LLM 을 따름
# QUERY_PARSE_MODEL_NAME: 자연어 검색 조건 변환(10-3). 미설정 시 LLM 을 따름
# VISION_MODEL_NAME: 이미지 분석(비전 폴백 경로)
# EMBEDDING_MODEL_NAME: 카테고리 판정·검색 적재용 임베딩
LLM_MODEL_NAME=gemini-2.5-flash
INFORMATIVE_MODEL_NAME=gemini-2.5-flash
DOCUMENT_MODEL_NAME=gemini-3.5-flash
QUERY_PARSE_MODEL_NAME=gemini-2.5-flash-lite
VISION_MODEL_NAME=gemini-2.5-flash-lite
EMBEDDING_MODEL_NAME=gemini-embedding-2

# GEMINI_THINKING_BUDGET: 2.5 계열 thinking 토큰 상한. 0=끔, 음수=미전송(모델 기본값)
# GEMINI_THINKING_LEVEL: 3.x 계열 thinking 강도(minimal/low/medium/high). 빈 값=미전송
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=


# ── Claude (LLM_PROVIDER=claude 일 때만 쓰인다) ────────────────────────────
# 위 LLM_MODEL_NAME 등은 **Gemini 전용**이다. 두 프로바이더는 모델 카탈로그가
# 겹치지 않으므로 env 이름공간도 분리했다 — 그래서 LLM_PROVIDER 만 claude 로
# 바꿔도 위에 박힌 gemini-2.5-flash 가 Anthropic 으로 새서 404 나는 일이 없다.
# 아래 CLAUDE_*_MODEL_NAME 은 전부 선택이며, 비워 두면 코드 기본값을 쓴다.
#
# 모델 기본값(코드): AGENT=claude-sonnet-4-6, 비전=claude-haiku-4-5,
#   INFORMATIVE/DOCUMENT/QUERY_PARSE 는 미설정 시 AGENT 를 따른다.
#   ⚠️ 4-6 계열 고정이다. 2026-08-04 실측에서 sonnet-5 는 같은 요청에 529/503 을
#      3연속 냈고 sonnet-4-6·haiku-4-5 는 1차 성공이었다. 529 는 업스트림 용량
#      문제라 코드로 없앨 수 없어 모델 선택으로 회피한다.
#
# CLAUDE_BASE_URL: auth2api 주소. 비우면 SDK 기본 호스트(api.anthropic.com) 직결.
#   아래 값은 **호스트에서 uvicorn 으로 직접 띄울 때만** 맞다.
#
#   ⚠️ 도커로 띄우면 이 값으로는 닿지 않는다. 컨테이너 안의 127.0.0.1 은 컨테이너
#      자신이고, host.docker.internal 로 바꿔도 마찬가지다 — auth2api 는
#      127.0.0.1:8317 **루프백에만** 바인딩하는데(config.yaml 의 host: ''),
#      host-gateway 로 나간 요청은 호스트의 브리지 IP 로 도착해 거부된다.
#      docker-compose.yml 의 MinIO 주석이 설명하는 것과 같은 함정이다.
#
#   도커에서 쓰려면 셋 중 하나를 골라야 한다:
#     (a) auth2api 를 같은 compose 네트워크의 컨테이너로 올리고
#         CLAUDE_BASE_URL=http://auth2api:8317  (auth2api 에 Dockerfile 있음)
#     (b) auth2api 의 config.yaml 에서 host 를 0.0.0.0 으로 바꿔 노출 +
#         extra_hosts 로 host.docker.internal 매핑
#         → 개인 Claude 구독 프록시를 LAN 에 여는 것이므로 방화벽 확인 필수
#     (c) AI 서버만 호스트에서 uvicorn 으로 돌린다(아래 값 그대로 사용)
# CLAUDE_API_KEY: auth2api config.yaml 의 api-keys 첫 값. 직결이면 sk-ant-... 키.
#   LLM_PROVIDER=claude 이고 MOCK_AI=false 일 때만 필수다.
# CLAUDE_MAX_TOKENS: 출력 상한. **목표치가 아니라 천장**이라 넉넉해도 비용이 늘지
#   않는다(모델은 end_turn 에서 멈춘다). 문서 생성은 다구간 장문이라 8000 이면
#   잘릴 수 있고, 비스트리밍은 16000 까지가 SDK HTTP 타임아웃 안쪽이다.
# CLAUDE_TIMEOUT: 호출 1회당 타임아웃(초). anthropic SDK 는 초 단위다.
# CLAUDE_MAX_RETRIES: SDK 자동 재시도 횟수. 408/409/429/5xx(529 overloaded 와
#   auth2api 의 503 포함)를 지수 백오프로 재시도한다. GEMINI_MAX_ATTEMPTS 대응.
# CLAUDE_IMAGE_LONG_EDGE: 이미지 입력 예산(px). 실제로는 면적 기준으로 적용한다
#   (긴 변만 자르면 세로로 긴 캡처에서 폭이 붕괴 — app/llm/claude.py _fit 참고).
#   sonnet-4-6·haiku-4-5 는 1568px 계층이다. opus-4-7 이상이나 sonnet-5 로 올릴
#   때 2576 으로 함께 올린다.
#   GMS 의 본문 90KB 한도가 없으므로 40KB q50 강제 열화는 여기서 사라진다.
CLAUDE_BASE_URL=http://127.0.0.1:8317
CLAUDE_API_KEY=
CLAUDE_LLM_MODEL_NAME=
CLAUDE_VISION_MODEL_NAME=
CLAUDE_INFORMATIVE_MODEL_NAME=
CLAUDE_DOCUMENT_MODEL_NAME=
CLAUDE_QUERY_PARSE_MODEL_NAME=
CLAUDE_MAX_TOKENS=16000
CLAUDE_TIMEOUT=90
CLAUDE_MAX_RETRIES=5
CLAUDE_IMAGE_LONG_EDGE=1568

# 임베딩 차원: 팀 합의 고정값. pgvector 컬럼 vector(768) 과 반드시 일치해야 한다.
# 모델 기본 출력은 3072 라 호출 시 이 값으로 줄여서 받는다.
# 바꾸면 저장된 임베딩을 전부 다시 생성해야 하므로 임의로 변경하지 말 것.
EMBEDDING_DIM=768


# ── 분류 파라미터 ─────────────────────────────────────────────────────────
# SIMILARITY_THRESHOLD: 이 값 미만이면 기존 카테고리에 못 붙였다고 보고 신규 제안.
#                       실제 데이터 분포를 보고 조정해야 하는 값이다.
# DEFAULT_MAX_TAGS: AGENT 가 생성할 태그 최대 개수
# HTTP_TIMEOUT: 이미지 다운로드 등 외부 HTTP 호출 타임아웃(초). Gemini 는 GEMINI_TIMEOUT.
SIMILARITY_THRESHOLD=0.80
DEFAULT_MAX_TAGS=10
HTTP_TIMEOUT=30

# ── 사용자 식별 ───────────────────────────────────────────────────────────
# FIXED_USER_ID: MVP 는 회원가입·로그인이 없어 요청이 보내는 userId 를 검증할 수 없다.
#   값이 있으면 요청 값을 무시하고 항상 이 값으로 처리한다(분석·목록·검색 전부 동일).
#   로그인이 붙으면 0 으로 바꾸는 것만으로 요청 값 사용으로 되돌아간다.
FIXED_USER_ID=1


# ── 썸네일 ────────────────────────────────────────────────────────────────
# S3_THUMBNAIL_BUCKET: 썸네일 전용 버킷. 분석할 때 리사이즈본을 만들어
#   **원본과 같은 key** 로 여기에 올린다(pictures/u/1/a.png → thumbnails/u/1/a.png).
#   서버 MinIO 의 실제 버킷명은 `thumbnails`(복수)다. 원본은 `pictures`.
#   비워 두면 저장하지 않고 요청 때마다 원본을 읽어 즉석 생성한다.
# THUMBNAIL_SQUARE: true 면 가운데를 잘라 정사각으로 만든다. 카테고리 카드와
#   격자 목록이 정사각이라 서버에서 모양을 맞춰 두면 앱이 자를 필요가 없다.
#   false 면 원본 비율을 그대로 둔다.
# THUMBNAIL_MAX_SIZE: 축소 상한(px). 0 이면 축소하지 않고 해상도는 원본 그대로 둔다
#   (모양만 정사각으로 맞추는 용도). 목록이 무거우면 480 정도를 넣어 줄인다. 확대는 안 한다.
# THUMBNAIL_QUALITY: JPEG 품질(1~95).
#
# 썸네일은 사진 1장당 1개다. 카테고리 카드는 그 카테고리에 가장 최근 분류된
# 사진의 썸네일을 그대로 가리킨다(카테고리 전용 이미지를 따로 만들지 않는다).
S3_THUMBNAIL_BUCKET=thumbnails
THUMBNAIL_SQUARE=true
THUMBNAIL_MAX_SIZE=0
THUMBNAIL_QUALITY=82


# ── 대량 처리 안정성 ──────────────────────────────────────────────────────
# MAX_CONCURRENT_STAGES: 동시에 처리할 분석 수. 수백 장이 몰려도 이 수만큼만
#                        동시에 돌아 Gemini 호출 폭주(429)를 막는다.
#                        키의 분당 한도가 낮으면 줄인다.
# GEMINI_MAX_ATTEMPTS: 429 발생 시 재시도 횟수
# GEMINI_BACKOFF_BASE: 재시도 백오프 기준(초). 1 → 2 → 4 … 로 증가
# GEMINI_BACKOFF_MAX: 백오프 상한(초). Gemini 가 40초 이상 대기를 요구하는
#                     경우가 있어 30 보다 여유 있게 잡는다.
# GEMINI_TIMEOUT: Gemini 호출 1회당 타임아웃(초). SDK 기본값은 무제한이라 응답이
#                 오지 않는 요청 하나가 워커 스레드를 영구 점유한다.
#                 nginx proxy_read_timeout(120s) 안에 들어오도록 90 으로 둔다.
MAX_CONCURRENT_STAGES=4
GEMINI_MAX_ATTEMPTS=5
GEMINI_BACKOFF_BASE=1.0
GEMINI_BACKOFF_MAX=60
GEMINI_TIMEOUT=90
