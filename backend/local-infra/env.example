# 로컬 개발 인프라 환경변수 (docker compose 용)
# cp .env.example .env 후 값 채우기. 로컬 개발용이라 약한 비번이어도 무방.
# 이 파일(.env)은 git 에 커밋되지 않는다 (.gitignore 확인).

# --- PostgreSQL ---
POSTGRES_DB=modera
POSTGRES_USER=admin
POSTGRES_PASSWORD=localdev

# --- MinIO (S3 호환) ---
# 앱의 S3_ACCESS_KEY / S3_SECRET_KEY 와 반드시 일치시킬 것.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
